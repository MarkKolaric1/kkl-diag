+using BitFab.KW1281Test.Kwp2000;
+using Shouldly;
+
+namespace BitFab.KW1281Test.Tests;
+
+[TestClass]
+public class Kwp2000DiagnosticsTests
+{
+    [TestMethod]
+    public void ParseDtcs_NoCodes()
+    {
+        Kwp2000Diagnostics.ParseDtcs([0x00]).ShouldBeEmpty();
+    }
+
+    [TestMethod]
+    public void ParseDtcs_PresentAndStoredCodes()
+    {
+        // 2 codes: 00283 present (status $63), 01276 stored only (status $23)
+        var dtcs = Kwp2000Diagnostics.ParseDtcs([0x02, 0x01, 0x1B, 0x63, 0x04, 0xFC, 0x23]);
+
+        dtcs.Count.ShouldBe(2);
+        dtcs[0].Code.ShouldBe(283);
+        dtcs[0].IsPresent.ShouldBeTrue();
+        dtcs[0].ToString().ShouldBe("00283 - 03-00");
+        dtcs[1].Code.ShouldBe(1276);
+        dtcs[1].IsPresent.ShouldBeFalse();
+        dtcs[1].ToString().ShouldBe("01276 - 03-10");
+    }
+
+    [TestMethod]
+    public void ParseDtcs_IgnoresTrailingPartialEntry()
+    {
+        Kwp2000Diagnostics.ParseDtcs([0x01, 0x01, 0x1B, 0x63, 0x04]).Count.ShouldBe(1);
+    }
+}
