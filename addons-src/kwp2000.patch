+    /// <summary>
+    /// Sends raw message bytes (checksum appended here) and returns whatever bytes arrive
+    /// within listenMs. For probing modules whose expected header format is unknown.
+    /// </summary>
+    public List<byte> SendRawAndCollect(byte[] message, int listenMs)
+    {
+        byte checksum = 0;
+        foreach (var b in message)
+        {
+            checksum += b;
+        }
+
+        Thread.Sleep(P3);
+        foreach (var b in message)
+        {
+            _kwpCommon.WriteByte(b);
+            Thread.Sleep(P4);
+        }
+        _kwpCommon.WriteByte(checksum);
+        Log.WriteLine($"Sent raw:{Utils.Dump(message)} {checksum:X2}");
+
+        var received = new List<byte>();
+        var oldTimeout = _kwpCommon.Interface.ReadTimeout;
+        try
+        {
+            _kwpCommon.Interface.ReadTimeout = listenMs;
+            while (true)
+            {
+                received.Add(_kwpCommon.ReadByte());
+                _kwpCommon.Interface.ReadTimeout = 100; // response bytes arrive close together
+            }
+        }
+        catch (TimeoutException)
+        {
+        }
+        finally
+        {
+            _kwpCommon.Interface.ReadTimeout = oldTimeout;
+        }
+
+        Log.WriteLine(received.Count == 0 ? "Received: (nothing)" : $"Received raw:{Utils.Dump(received)}");
+        return received;
+    }
